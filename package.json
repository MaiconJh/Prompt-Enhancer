{
  "name": "prompt-enhancer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sandbox": "node sandbox.cjs",
    "build": "node build.js",
    "build:dev": "node build.js --dev",
    "check:i18n": "bash scripts/check-i18n.sh",
    "check": "npm run check:i18n && node check.js",
    "check:dev": "node check.js --dev",
    "serve": "node serve-dist.js",
    "dev": "node serve-dist.js --watch-build",
    "test": "npm run check && node --test src/tests/*-tests.js",
    "test:api": "PE_API_SMOKE=1 node --test src/tests/provider-api-integration-tests.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.65.0"
  }
}
